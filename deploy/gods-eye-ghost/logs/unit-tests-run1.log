          finishTuner(true);
          try { this._radioTunerSlider.releasePointerCapture(event.pointerId); } catch { /* already released */ }
          event.preventDefault();
        }, tunerListenerOptions);
        this._radioTunerSlider?.addEventListener('pointercancel', (event) => {
