        kind: 'aircraft',
        id: icao24,
        hex: icao24,
        callsign: info.callsign || '',
        classification: 'CIVIL AIRCRAFT',
        title: String(info.callsign || info.registration || icao24).trim().toUpperCase(),
        origin: info.route?.origin ? formatAirport(info.route.origin) : (info.originCountry || 'UNKNOWN'),
        destination: info.route?.destination ? formatAirport(info.route.destination) : 'UNKNOWN',
        fields: [
