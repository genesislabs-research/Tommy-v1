          { label: 'CALLSIGN', value: info.callsign || 'UNKNOWN' },
          { label: 'REGISTRATION', value: info.registration || 'UNKNOWN' },
          { label: 'AIRFRAME', value: info.typeName || info.klass || 'UNKNOWN' },
          { label: 'OPERATOR', value: info.airline || 'UNKNOWN' },
          { label: 'COUNTRY', value: info.originCountry || 'UNKNOWN' },
          { label: 'ALTITUDE', value: formatFeetFromMeters(info.altitude) },
          { label: 'SPEED', value: formatKnotsFromMps(info.velocity) },
          { label: 'HEADING', value: Number.isFinite(heading) ? `${Math.round(heading)}°` : 'UNKNOWN' },
