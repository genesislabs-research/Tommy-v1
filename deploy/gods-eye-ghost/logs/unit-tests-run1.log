        }, tunerListenerOptions);
        this._radioTunerSlider?.addEventListener('change', () => {
          if (this._radioTunerPointerId === null && !this._radioTunerKeyboardKey) finishTuner(true);
        }, tunerListenerOptions);
        this._radioTunerSlider?.addEventListener('pointerup', (event) => {
